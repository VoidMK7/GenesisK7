name: Deploy to Supabase
on:
  workflow_dispatch:
    inputs:
      migrations: { description: "Apply database migrations", type: boolean, default: true }
      function: { description: "Deploy the api function and secrets", type: boolean, default: true }
jobs:
  deploy:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: novatrade } }
    env:
      SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
      DB_URL: ${{ secrets.SUPABASE_DB_URL }}
      REF: ${{ secrets.SUPABASE_PROJECT_REF }}
    steps:
      - uses: actions/checkout@v4
      - uses: supabase/setup-cli@v1
        with: { version: latest }
      - name: Apply migrations
        if: ${{ inputs.migrations }}
        run: |
          set -euo pipefail
          psql "$DB_URL" -v ON_ERROR_STOP=1 -c "create table if not exists public._nova_migrations (name text primary key, applied_at timestamptz default now())"
          for f in $(ls supabase/migrations/*.sql | sort); do
            n=$(basename "$f")
            if [ "$(psql "$DB_URL" -tA -c "select 1 from public._nova_migrations where name='$n'")" = "1" ]; then echo "skip $n"; continue; fi
            echo "applying $n"
            psql "$DB_URL" -v ON_ERROR_STOP=1 --single-transaction -f "$f"
            psql "$DB_URL" -v ON_ERROR_STOP=1 -c "insert into public._nova_migrations(name) values ('$n')"
          done
      - name: Set function secrets
        if: ${{ inputs.function }}
        run: |
          supabase secrets set --project-ref "$REF" \
            CREDENTIAL_ENCRYPTION_KEY='${{ secrets.CREDENTIAL_ENCRYPTION_KEY }}' \
            CRON_SECRET='${{ secrets.CRON_SECRET }}' \
            ALLOWED_ORIGINS='${{ secrets.ALLOWED_ORIGINS }}'
      - name: Deploy api function
        if: ${{ inputs.function }}
        run: supabase functions deploy api --project-ref "$REF" --no-verify-jwt
