import { useRouter } from "next/navigation";

export default function RoleSelect({ userId, role, disabled }: { userId: string; role: string; disabled?: boolean }) {
  const router = useRouter();
  async function change(e: React.ChangeEvent<HTMLSelectElement>) {
    const res = await fetch("/api/admin/users", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ userId, role: e.target.value }),
    });
    if (!res.ok) alert((await res.json().catch(() => ({}))).error || "Failed");
    router.refresh();
  }
  return (
    <select defaultValue={role} onChange={change} disabled={disabled} className="rounded border border-slate-700 bg-slate-950 px-2 py-1 text-sm">
      <option value="user">user</option>
      <option value="teacher">teacher (teaching access)</option>
      <option value="admin">admin</option>
    </select>
  );
}
���������������������������������������������������������������������������������������������������������������������tradepilot/components/TeachClient.tsx���������������������������������������������������������������0000644�0000000�0000000�00000005703�15267717321�017053� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������"use client";
import { useState } from "react";
import { useRouter } from "next/navigation";

type CardLite = { id: string; title: string; kind: string; notes: string; tags: string[]; filename?: string; createdAt: string };

export default function TeachClient({ cards }: { cards: CardLite[] }) {
  const router = useRouter();
  const [msg, setMsg] = useState("");
  const [busy, setBusy] = useState(false);

  async function upload(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const form = e.currentTarget;
    setBusy(true); setMsg("");
    const res = await fetch("/api/teach/upload", { method: "POST", body: new FormData(form) });
    const j = await res.json().catch(() => ({}));
    setBusy(false);
    if (!res.ok) return setMsg(j.error || "Upload failed");
    form.reset(); setMsg("Saved to AI memory."); router.refresh();
  }
  async function remove(id: string) {
    if (!confirm("Delete this learning card?")) return;
    await fetch(`/api/teach/cards?id=${id}`, { method: "DELETE" });
    router.refresh();
  }

  return (
    <div className="space-y-6">
      <form onSubmit={upload} className="card space-y-3">
        <h2 className="font-semibold">Add a learning card</h2>
        <input name="title" required placeholder="Title (e.g. 'London session breakout setup')" className="input" />
        <textarea name="notes" rows={4} placeholder="What should the AI learn from this? Rules, entry/exit logic, risk notes..." className="input" />
        <input name="tags" placeholder="Tags, comma separated (btc, breakout, scalping)" className="input" />
        <input name="file" type="file" accept="video/*,image/*,.csv,.txt,.md,.json" className="text-sm" />
        <p className="text-xs text-slate-500">Text/CSV files are read into memory. Videos and images are stored, but their content is NOT yet analysed: put the key lessons in the notes.</p>
        <div className="flex items-center gap-3">
          <button className="btn" disabled={busy}>{busy ? "Uploading..." : "Save card"}</button>
          {msg && <span className="text-sm text-slate-300">{msg}</span>}
        </div>
      </form>

      <div className="space-y-2">
        <h2 className="font-semibold">Memory ({cards.length} cards)</h2>
        {cards.length === 0 && <p className="text-sm text-slate-500">Nothing yet.</p>}
        {cards.map((c) => (
          <div key={c.id} className="card flex items-start justify-between gap-4">
            <div className="min-w-0">
              <div className="font-medium">{c.title} <span className="ml-2 rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-400">{c.kind}</span></div>
              {c.notes && <p className="mt-1 line-clamp-3 text-sm text-slate-400">{c.notes}</p>}
              {c.tags.length > 0 && <p className="mt-1 text-xs text-emerald-400">#{c.tags.join(" #")}</p>}
            </div>
            <button className="btn-ghost shrink-0" onClick={() => remove(c.id)}>Delete</button>
          </div>
        ))}
      </div>
    </div>
  );
}
�������������������������������������������������������������tradepilot/components/AuthForm.tsx������������������������������������������������������������������0000644�0000000�0000000�00000003573�15267725021�016414� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������"use client";
import { useState } from "react";
import { useRouter } from "next/navigation";

export default function AuthForm() {
  const router = useRouter();
  const [mode, setMode] = useState<"login" | "register">("login");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  async function submit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setBusy(true);
    setError("");
    const f = new FormData(e.currentTarget);
    const res = await fetch(`/api/auth/${mode}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.fromEntries(f)),
    });
    const j = await res.json().catch(() => ({}));
    setBusy(false);
    if (!res.ok) return setError(j.error || "Something went wrong");
    if (j.confirm) { setMode("login"); return setError("Check your email to confirm your account, then log in."); }
    router.push("/chat");
    router.refresh();
  }

  return (
    <form onSubmit={submit} className="card w-full max-w-sm space-y-3">
      <h1 className="text-xl font-semibold">{mode === "login" ? "Log in" : "Create account"}</h1>
      {mode === "register" && <input name="name" placeholder="Name" required className="input" />}
      <input name="email" type="email" placeholder="Email" required className="input" />
      <input name="password" type="password" placeholder="Password (min 8 chars)" minLength={8} required className="input" />
      {error && <p className="text-sm text-red-400">{error}</p>}
      <button className="btn w-full" disabled={busy}>{busy ? "..." : mode === "login" ? "Log in" : "Sign up"}</button>
      <button type="button" className="text-xs text-slate-400 underline" onClick={() => setMode(mode === "login" ? "register" : "login")}>
        {mode === "login" ? "Need an account? Sign up" : "Have an account? Log in"}
      </button>
    </form>
  );
}
�������������������������������������������������������������������������������������������������������������������������������������tradepilot/components/ChatClient.tsx����������������������������������������������������������������0000644�0000000�0000000�00000005425�15267717351�016712� 0����������������������������������������������������������������������������������������������������ustar  �root����������������������������root�������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������������"use client";
import { useState } from "react";

type Msg = { role: "user" | "ai"; text: string; img?: string; cards?: string[] };

export default function ChatClient() {
  const [msgs, setMsgs] = useState<Msg[]>([]);
  const [input, setInput] = useState("");
  const [image, setImage] = useState<{ mediaType: string; data: string; url: string } | null>(null);
  const [busy, setBusy] = useState(false);

  function pick(e: React.ChangeEvent<HTMLInputElement>) {
    const f = e.target.files?.[0];
    if (!f) return;
    if (f.size > 4 * 1024 * 1024) return alert("Image must be under 4MB");
    const r = new FileReader();
    r.onload = () => {
      const url = String(r.result);
      setImage({ mediaType: f.type, data: url.split(",")[1], url });
    };
    r.readAsDataURL(f);
  }

  async function send(e: React.FormEvent) {
    e.preventDefault();
    if (busy || (!input.trim() && !image)) return;
    const mine: Msg = { role: "user", text: input, img: image?.url };
    setMsgs((m) => [...m, mine]);
    setBusy(true);
    const body = { message: input, image: image ? { mediaType: image.mediaType, data: image.data } : undefined };
    setInput(""); setImage(null);
    const res = await fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const j = await res.json().catch(() => ({}));
    setBusy(false);
    setMsgs((m) => [...m, { role: "ai", text: res.ok ? j.reply : `Error: ${j.error || "request failed"}`, cards: j.usedCards }]);
  }

  return (
    <div className="flex h-[calc(100vh-8rem)] flex-col">
      <div className="flex-1 space-y-3 overflow-y-auto pb-4">
        {msgs.length === 0 && <p className="text-sm text-slate-500">Ask about a market, or attach a chart screenshot for analysis. Educational analysis only, not financial advice.</p>}
        {msgs.map((m, i) => (
          <div key={i} className={`card max-w-[85%] whitespace-pre-wrap text-sm ${m.role === "user" ? "ml-auto bg-slate-800" : ""}`}>
            {m.img && <img src={m.img} alt="chart" className="mb-2 max-h-60 rounded" />}
            {m.text}
            {m.cards && m.cards.length > 0 && <div className="mt-2 text-xs text-emerald-400">Used taught knowledge: {m.cards.join(", ")}</div>}
          </div>
        ))}
        {busy && <p className="text-sm text-slate-500">Thinking...</p>}
      </div>
      <form onSubmit={send} className="flex items-center gap-2">
        <label className="btn-ghost cursor-pointer">{image ? "Image ✓" : "Chart"}<input type="file" accept="image/png,image/jpeg,image/webp" hidden onChange={pick} /></label>
        <input value={input} onChange={(e) => setInput(e.target.value)} placeholder="Ask about the market..." className="input" />
        <button className="btn" disabled={busy}>Send</button>
      </form>
    </div>
  );
}
